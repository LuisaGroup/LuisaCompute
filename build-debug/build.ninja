build bin/tutorial_11_black_hole: CXX_EXECUTABLE_LINKER__tutorial_11_black_hole_Debug tutorials/CMakeFiles/tutorial_11_black_hole.dir/11_black_hole/main.cpp.o | bin/libluisa-osl.so bin/libluisa-gui.so bin/libluisa-api.so bin/libluisa-coro.so bin/libluisa-xir.so bin/libluisa-dsl.so bin/libluisa-runtime.so bin/libluisa-ir.so bin/libluisa-ast.so bin/libluisa-core.so bin/libluisa-ext-glfw.so.3.5 bin/libglslang.so.16.3.0 || bin/libglslang.so bin/libluisa-api.so bin/libluisa-ast.so bin/libluisa-backend-cpu.so bin/libluisa-backend-cuda.so bin/libluisa-backend-fallback.so bin/libluisa-backend-remote.so bin/libluisa-backend-vk.so bin/libluisa-core.so bin/libluisa-coro.so bin/libluisa-dsl.so bin/libluisa-ext-glfw.so bin/libluisa-gui.so bin/libluisa-ir.so bin/libluisa-osl.so bin/libluisa-runtime.so bin/libluisa-validation-layer.so bin/libluisa-xir.so luisa-compute-include src/rust/libluisa_compute_api_types.a src/rust/libluisa_compute_ir_static.a src/rust/luisa_compute_rust_build bin/libluisa-ext-glfw.so bin/libglslang.so
  CONFIG = Debug
  DEP_FILE = tutorials/CMakeFiles/tutorial_11_black_hole.dir/link.d
  FLAGS = -g
  LINK_FLAGS = -Wl,--dependency-file=tutorials/CMakeFiles/tutorial_11_black_hole.dir/link.d
  LINK_LIBRARIES = -Wl,-rpath,"\$$ORIGIN:\$$ORIGIN/../bin:\$$ORIGIN/../lib"  bin/libluisa-osl.so  bin/libluisa-gui.so  bin/libluisa-api.so  bin/libluisa-coro.so  bin/libluisa-xir.so  bin/libluisa-dsl.so  bin/libluisa-runtime.so  bin/libluisa-ir.so  bin/libluisa-ast.so  bin/libluisa-core.so  -ldl  bin/libluisa-ext-glfw.so.3.5  bin/libglslang.so.16.3.0  -Wl,-Bstatic  -lluisa_compute_ir_static  -lluisa_compute_api_types  -Wl,-Bdynamic
  LINK_PATH = -L/home/mike/Projects/luisa/build-debug/bin
  OBJECT_DIR = tutorials/CMakeFiles/tutorial_11_black_hole.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_COMPILE_PDB = tutorials/CMakeFiles/tutorial_11_black_hole.dir/
  TARGET_FILE = bin/tutorial_11_black_hole
  TARGET_PDB = lib/tutorial_11_black_hole.pdb
  TARGET_SUPPORT_DIR = tutorials/CMakeFiles/tutorial_11_black_hole.dir


#############################################
# Utility command for test

build tutorials/CMakeFiles/test.util: CUSTOM_COMMAND
  COMMAND = cd /home/mike/Projects/luisa/build-debug/tutorials && /usr/bin/ctest
  DESC = Running tests...
  pool = console
  restat = 1

build tutorials/test: phony tutorials/CMakeFiles/test.util


