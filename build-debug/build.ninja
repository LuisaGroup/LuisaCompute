build tutorials/list_install_components: phony


#############################################
# Utility command for install

build tutorials/CMakeFiles/install.util: CUSTOM_COMMAND tutorials/all
  COMMAND = cd /home/mike/Projects/luisa/build-debug/tutorials && /usr/bin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

build tutorials/install: phony tutorials/CMakeFiles/install.util


#############################################
# Utility command for install/local

build tutorials/CMakeFiles/install/local.util: CUSTOM_COMMAND tutorials/all
