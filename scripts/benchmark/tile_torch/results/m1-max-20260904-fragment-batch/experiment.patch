+void test_matrix_load_batches(Runtime &runtime) {
+    if (runtime.target() != "metal") { return; }
+    Shape cases[]{
+        {64, 64, 65, 32, 64, 32}, {37, 71, 45, 32, 64, 32}, {37, 71, 45, 32, 64, 32, true, false}, {37, 71, 45, 32, 64, 32, false, true}, {37, 71, 45, 32, 64, 32, true, true}, {37, 71, 45, 32, 64, 24}, {37, 71, 45, 32, 64, 8}};
+    for (auto cfg : cases) {
+        for (auto batch : {1u, 2u, 4u}) {
+            for (auto window : {1u, 2u}) {
+                auto kernel = gemm(runtime, cfg, window);
+                bridge::tirx::PlannerOptions planner;
+                planner.threads_per_group = 256u;
+                planner.max_copy_batch = 4u;
+                planner.max_matrix_load_batch = batch;
+                auto executable = runtime.build(kernel, false, true, true, false, planner);
+                expect(executable.ok()) << executable.error;
+                if (!executable.ok()) { continue; }
+                auto expected = batch;
+                while (cfg.bk / 8 % expected != 0u) { expected--; }
+                expect(eq(executable.plans.size(), size_t{1u}));
+                if (executable.plans.size() == 1u) {
+                    auto &plan = executable.plans[0];
+                    // The small BK=8 allocation fits the eager software
+                    // pipeline version budget. Its steady state and drain
+                    // contain separate MMA sites, including in batch one.
+                    auto matrix_sites = cfg.bk == 8 && window == 2u ? size_t{2u} : size_t{1u};
+                    expect(eq(plan.matrices.size(), matrix_sites)) << cfg.bk << " batch=" << batch << " window=" << window;
+                    for (auto &matrix : plan.matrices) {
+                        expect(matrix.rectangular());
+                        expect(eq(matrix.k_atom_batch, expected));
+                        expect(eq(plan.cost.fragment_scalars_per_lane,
+                                  2ull * (matrix.atom_rows * matrix.atom_columns + expected * (matrix.atom_rows + matrix.atom_columns))));
+                    }
+                }
+                check_gemm(runtime, executable, cfg);
+            }
+        }
+    }
+}
