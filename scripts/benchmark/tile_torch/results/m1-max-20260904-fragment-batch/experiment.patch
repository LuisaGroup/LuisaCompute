+void test_matrix_load_batch_resources() {
+    auto work = workload(32, 64, 32);
+    ExecutionLimits limits{256u, 32u, 32768u};
+    PlannerOptions options;
+    options.threads_per_group = 128u;
+    options.max_matrix_load_batch = 2u;
+    auto planned = plan_group(work, limits, options);
+    expect(planned.ok()) << planned.error;
+    if (planned) {
+        expect(planned.plan.matrices[0].rectangular());
+        expect(eq(planned.plan.matrices[0].k_atom_batch, 2u));
+        expect(eq(planned.plan.cost.fragment_scalars_per_lane, 40ull));
+        check_coverage(work.matrices[0], planned.plan.matrices[0], 128u);
+        auto invalid = planned.plan.matrices[0];
+        invalid.k_atom_batch = 3u;
+        expect(!verify_matrix_distribution(work.matrices[0], invalid, 128u, 32u));
+    }
+    options.max_fragment_scalars_per_lane = 6u;
+    auto reference = plan_group(work, limits, options);
+    expect(reference.ok());
+    expect(!reference.plan.matrices[0].rectangular());
+    expect(eq(reference.plan.matrices[0].k_atom_batch, 1u));
+    for (auto invalid : {0u, 5u}) {
+        options.max_matrix_load_batch = invalid;
+        expect(!plan_group(work, limits, options));
+    }
