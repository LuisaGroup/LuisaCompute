+        expect(audit.second == (std::array<uint32_t, 3u>{1u, 1u, 1u}));
+        expect(audit.widths && audit.uniform);
+        expect(audit.fences == 3u);
+        auto source = std::string_view{result.artifact.source.data(), result.artifact.source.size()};
+        auto count = [&](std::string_view needle) {
+            auto total = size_t{0u}, cursor = size_t{0u};
+            while ((cursor = source.find(needle, cursor)) != std::string_view::npos) { total++; cursor += needle.size(); }
+            return total;
+        };
+        expect(count("int butterfly_width = 32") == 3u);
+        expect(count("__shfl_xor_sync(0xffffffffu, value, offset, 32)") == 3u);
+        expect(source.find("__activemask") == std::string_view::npos);
+    }
+}
+
