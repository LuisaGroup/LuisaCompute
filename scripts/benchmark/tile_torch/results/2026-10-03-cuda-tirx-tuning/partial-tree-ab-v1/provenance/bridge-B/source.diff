+void test_cuda_subgroup_partial_tree_artifacts() {
+    constexpr auto rows = 17u;
+    for (auto geometry : {std::array{2u, 2u}, std::array{3u, 3u}, std::array{4u, 2u},
+                          std::array{8u, 2u}, std::array{16u, 2u}, std::array{17u, 1u},
+                          std::array{32u, 1u}}) {
+        auto [subgroups, packing] = geometry;
+        auto threads = 32u * subgroups * packing;
+        auto columns = 32u * subgroups * 8u + 1u;
+        auto width = std::bit_ceil(subgroups);
+        auto definition = tile_kernel("cuda_subgroup_partial_tree", [=](TensorView<const float, 2> x,
+                                                                        TensorView<float, 2> sums,
+                                                                        TensorView<float, 2> minima,
+                                                                        TensorView<float, 2> maxima) {
+            auto one = axis("one", 1), feature = axis("feature", columns);
+            for (auto &program : parallel(shape(rows))) {
+                auto origin = coord(program.index(), 0);
+                auto value = x.tile(origin, shape(one, feature)).load();
+                // Broadcast each result across all worker lanes, not only the
+                // one lane owning a row scalar store.
+                sums(origin, shape(one, feature)).store(reduce(value, feature, add));
+                minima(origin, shape(one, feature)).store(reduce(value, feature, minimum));
+                maxima(origin, shape(one, feature)).store(reduce(value, feature, maximum));
+            }
+        });
+        auto kernel = definition.capture(tensor_shape(rows, columns), tensor_shape(rows, columns),
+                                         tensor_shape(rows, columns), tensor_shape(rows, columns));
+        expect(kernel.valid());
+        auto lowered = lower(kernel.function());
+        expect(lowered.ok()) << lowered.error;
+        if (!lowered) { continue; }
+        auto options = cuda_subgroup_options();
+        options.planner.threads_per_group = threads;
+        options.planner.reduction_programs_per_group = packing;
+        options.planner.reduction_lane_elements = 8u;
+        options.planner.cache_reduction_inputs = true;
+        auto result = compile_device(lowered.value, kernel.function().name(), options);
+        expect(static_cast<bool>(result)) << "S=" << subgroups << " P=" << packing << " " << result.error;
+        if (!result) { continue; }
+        expect_cuda_subgroup_source(result.artifact);
+        expect(result.artifact.block == (std::array<uint32_t, 3u>{threads, 1u, 1u}));
+        expect(result.artifact.grid == (std::array<uint32_t, 3u>{ceil_div(rows, packing), 1u, 1u}));
+        expect(result.plans.size() == 1u);
+        if (result.plans.size() == 1u) {
+            auto &plan = result.plans.front();
+            expect(plan.reduction_subgroups_per_program == subgroups);
+            expect(plan.reduction_programs_per_group == packing);
+            expect(plan.reduction_operations == 3u);
+            expect(plan.shared_memory_bytes == 3u * subgroups * packing * sizeof(float));
+            expect(plan.group_barrier_sites_after == 3u);
+        }
+        class PartialTreeAudit final : public tvm::tirx::StmtExprVisitor {
+        private:
+            uint32_t _branch_depth{0u};
+            uint32_t _width;
+            void VisitStmt_(const tvm::tirx::IfThenElseNode *branch) final {
+                _branch_depth++;
+                StmtExprVisitor::VisitStmt_(branch);
+                _branch_depth--;
+            }
+            void VisitExpr_(const tvm::CallNode *call) final {
+                if (call->op.same_as(tvm::tirx::builtin::tvm_storage_sync())) {
+                    fences++;
+                    uniform &= _branch_depth == 0u;
+                }
+                auto name = call->args.empty() ? nullptr : call->args[0u].as<tvm::tirx::StringImmNode>();
+                if (name != nullptr) {
+                    std::string_view text{name->value.data(), name->value.size()};
+                    auto kind = text == "__luisa_tile_cuda_warp_sum" ? 0u :
+                                text == "__luisa_tile_cuda_warp_min" ? 1u :
+                                text == "__luisa_tile_cuda_warp_max" ? 2u : 3u;
+                    if (kind != 3u) {
+                        uniform &= _branch_depth == 0u;
+                        if (call->args.size() == 2u) {
+                            first[kind]++;
+                        } else if (call->args.size() == 3u) {
+                            second[kind]++;
+                            auto literal = call->args[2u].as<tvm::IntImmNode>();
+                            widths &= literal != nullptr && literal->value == _width;
+                        } else {
+                            widths = false;
+                        }
+                    }
