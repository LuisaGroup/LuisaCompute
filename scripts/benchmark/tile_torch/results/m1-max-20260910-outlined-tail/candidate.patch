+[[nodiscard]] bool run_outlined_packet_tail_codegen() {
+    // Inspect call-site attributes before optimization. The candidate must
+    // leave the original function and every full-packet call without NoInline,
+    // and retain the dynamic lane-count operand on exactly the real tail.
+    ScopedEnvironmentVariable enable_full{"LUISA_SIMD_ENABLE_FULL_PACKET_SPECIALIZATION", "1"};
+    ScopedEnvironmentVariable disable_tail_narrowing{"LUISA_SIMD_DISABLE_LINEAR_1D_PACKET_TAIL_NARROWING", nullptr};
+    ScopedEnvironmentVariable disable_direct{"LUISA_SIMD_DISABLE_COHERENT_DIRECT_CFG", nullptr};
+    struct Policy {
+        const char *enable;
+        const char *disable;
+        bool full_packet;
+        bool outlined;
+    };
+    constexpr std::array policies{
+        Policy{nullptr, nullptr, true, false},
+        Policy{"0", nullptr, true, false},
+        Policy{"1", nullptr, false, false},
+        Policy{"1", nullptr, true, true},
+        Policy{"1", "1", true, false},
+        Policy{"true", "on", true, false},
+    };
+    for (auto width : {2u, 4u, 8u, 16u}) {
+        xir::Module source;
+        auto kernel = source.create_kernel();
+        kernel->set_block_size(luisa::make_uint3(32u, 1u, 1u));
+        auto output = kernel->create_resource_argument(Type::of<Buffer<uint32_t>>());
+        xir::XIRBuilder builder;
+        builder.set_insertion_point(kernel->create_body_block());
+        auto zero = source.create_constant_zero(Type::of<uint32_t>());
+        auto global = builder.call(Type::of<uint32_t>(), xir::ArithmeticOp::EXTRACT, {source.create_dispatch_id(), zero});
+        builder.call(xir::ResourceWriteOp::BUFFER_WRITE, {output, global, global});
+        builder.return_void();
+        auto schedule = schedule::lower_xir_to_schedule(kernel, {.logical_warp_width = width});
+        CHECK(schedule.succeeded());
+        for (auto inlined_batch : {false, true}) {
+            for (auto policy : policies) {
+                ScopedEnvironmentVariable enable_outline{"LUISA_SIMD_ENABLE_OUTLINED_PACKET_TAIL", policy.enable};
+                ScopedEnvironmentVariable disable_outline{"LUISA_SIMD_DISABLE_OUTLINED_PACKET_TAIL", policy.disable};
+                ScopedEnvironmentVariable disable_full{"LUISA_SIMD_DISABLE_FULL_PACKET_SPECIALIZATION", policy.full_packet ? nullptr : "1"};
+                ::llvm::LLVMContext context;
+                ::llvm::Module module{"outlined_packet_tail", context};
+                auto codegen = lower_schedule_to_llvm(
+                    module, *schedule.function, width, "outlined_packet_tail", false,
+                    {32u, 1u, 1u}, true, true, false, 1u, true, true, inlined_batch, true);
+                CHECK(codegen.succeeded() && codegen.direct_control_flow);
+                CHECK(codegen.packet_batch_entry != nullptr && codegen.block_batch_entry != nullptr);
+                CHECK(codegen.full_packet_specialization_count == (policy.full_packet ? 1u : 0u));
+                auto *full_packet = module.getFunction("outlined_packet_tail.full_packet");
+                CHECK((full_packet != nullptr) == policy.full_packet);
+                auto tail_calls = size_t{0u};
+                auto full_calls = size_t{0u};
+                auto noinline_calls = size_t{0u};
+                for (auto &function : module) {
+                    CHECK(!function.hasFnAttribute(::llvm::Attribute::NoInline));
+                    for (auto &block : function) {
+                        for (auto &instruction : block) {
+                            auto *call = ::llvm::dyn_cast<::llvm::CallInst>(&instruction);
+                            if (call == nullptr) { continue; }
+                            auto noinline_call = call->getAttributes().hasFnAttr(::llvm::Attribute::NoInline);
+                            noinline_calls += noinline_call ? 1u : 0u;
+                            if (block.getName() == "packet.batch.tail.call") {
+                                tail_calls++;
+                                CHECK(call->getCalledFunction() == codegen.entry);
+                                CHECK(call->arg_size() == 4u);
+                                CHECK(call->getArgOperand(3u)->getName() == "packet.tail.lane.count");
+                                CHECK(!::llvm::isa<::llvm::ConstantInt>(call->getArgOperand(3u)));
+                                CHECK(noinline_call == policy.outlined);
+                                CHECK(!call->getAttributes().hasFnAttr(::llvm::Attribute::AlwaysInline));
+                            } else {
+                                CHECK(!noinline_call);
+                                if (call->getCalledFunction() == (full_packet != nullptr ? full_packet : codegen.entry)) {
+                                    full_calls++;
+                                    CHECK(call->arg_size() == (full_packet != nullptr ? 3u : 4u));
+                                    if (full_packet == nullptr) {
+                                        auto *active_lanes = ::llvm::dyn_cast<::llvm::ConstantInt>(call->getArgOperand(3u));
+                                        CHECK(active_lanes != nullptr && active_lanes->getZExtValue() == width);
+                                    }
+                                }
+                            }
+                        }
+                    }
+                }
+                CHECK(tail_calls == 1u && full_calls > 0u);
+                CHECK(noinline_calls == (policy.outlined ? 1u : 0u));
+                CHECK(!::llvm::verifyModule(module, &::llvm::errs()));
+            }
+        }
+    }
+    return true;
+}
