    def __enter__(self) -> ForRangeScope: ...
    def __exit__(self, exc_type: Any, exc_val: Any, exc_tb: Any) -> bool: ...

class UnrolledForScope:
    builder: IRBuilder
    start: int
    stop: int
    step: int
    loop_var_name: str
    iterations: List[int]
    current_iteration: int
    
    def __init__(self, builder: IRBuilder, start: int, stop: int, step: int, loop_var_name: str) -> None: ...
    def __enter__(self) -> UnrolledForScope: ...
    def __exit__(self, exc_type: Any, exc_val: Any, exc_tb: Any) -> bool: ...
    def _bind_iteration(self, idx: int) -> bool: ...
