class SwitchScope:
    builder: IRBuilder
    value: Value
    cases: List[Tuple[List[int], IRBasicBlock]]
    default_block: Optional[IRBasicBlock]
    exit_block: Optional[IRBasicBlock]
    _folded: bool
    _constant_value: Any
    
    def __init__(self, builder: IRBuilder, value: Value) -> None: ...
    def __enter__(self) -> SwitchScope: ...
    def __exit__(self, exc_type: Any, exc_val: Any, exc_tb: Any) -> bool: ...
    def case(self, *values: int) -> Union[CaseScope, NoOpScope, DirectScope]: ...
    def default(self) -> Union[CaseScope, NoOpScope, DirectScope]: ...

class CaseScope:
