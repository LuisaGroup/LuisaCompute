build bin/libluisa-ext-glfw.so.3.5: C_SHARED_LIBRARY_LINKER__glfw_Release src/ext/glfw/src/CMakeFiles/glfw.dir/context.c.o src/ext/glfw/src/CMakeFiles/glfw.dir/init.c.o src/ext/glfw/src/CMakeFiles/glfw.dir/input.c.o src/ext/glfw/src/CMakeFiles/glfw.dir/monitor.c.o src/ext/glfw/src/CMakeFiles/glfw.dir/platform.c.o src/ext/glfw/src/CMakeFiles/glfw.dir/vulkan.c.o src/ext/glfw/src/CMakeFiles/glfw.dir/window.c.o src/ext/glfw/src/CMakeFiles/glfw.dir/egl_context.c.o src/ext/glfw/src/CMakeFiles/glfw.dir/osmesa_context.c.o src/ext/glfw/src/CMakeFiles/glfw.dir/null_init.c.o src/ext/glfw/src/CMakeFiles/glfw.dir/null_monitor.c.o src/ext/glfw/src/CMakeFiles/glfw.dir/null_window.c.o src/ext/glfw/src/CMakeFiles/glfw.dir/null_joystick.c.o src/ext/glfw/src/CMakeFiles/glfw.dir/posix_module.c.o src/ext/glfw/src/CMakeFiles/glfw.dir/posix_time.c.o src/ext/glfw/src/CMakeFiles/glfw.dir/posix_thread.c.o src/ext/glfw/src/CMakeFiles/glfw.dir/x11_init.c.o src/ext/glfw/src/CMakeFiles/glfw.dir/x11_monitor.c.o src/ext/glfw/src/CMakeFiles/glfw.dir/x11_window.c.o src/ext/glfw/src/CMakeFiles/glfw.dir/xkb_unicode.c.o src/ext/glfw/src/CMakeFiles/glfw.dir/glx_context.c.o src/ext/glfw/src/CMakeFiles/glfw.dir/linux_joystick.c.o src/ext/glfw/src/CMakeFiles/glfw.dir/posix_poll.c.o | /usr/lib/librt.a /usr/lib/libm.so
  CONFIG = Release
  DEP_FILE = src/ext/glfw/src/CMakeFiles/glfw.dir/link.d
  LANGUAGE_COMPILE_FLAGS = -O3 -DNDEBUG
  LINK_FLAGS = -shared -Wl,--dependency-file=src/ext/glfw/src/CMakeFiles/glfw.dir/link.d
  LINK_LIBRARIES = -Wl,-rpath,"\$$ORIGIN:\$$ORIGIN/../bin:\$$ORIGIN/../lib"  /usr/lib/librt.a  -lm  -ldl
  OBJECT_DIR = src/ext/glfw/src/CMakeFiles/glfw.dir
