  DEP_FILE = src/ast/CMakeFiles/luisa-compute-ast.dir/link.d
  LANGUAGE_COMPILE_FLAGS = -O3 -DNDEBUG
  LINK_FLAGS = -shared -Wl,--dependency-file=src/ast/CMakeFiles/luisa-compute-ast.dir/link.d
  LINK_LIBRARIES = -Wl,-rpath,"\$$ORIGIN:\$$ORIGIN/../bin:\$$ORIGIN/../lib"  bin/libluisa-core.so  bin/libluisa-ext-glfw.so.3.5  -ldl
  OBJECT_DIR = src/ast/CMakeFiles/luisa-compute-ast.dir
  POST_BUILD = :
  PRE_LINK = :
  SONAME = libluisa-ast.so
  SONAME_FLAG = -Wl,-soname,
  TARGET_FILE = bin/libluisa-ast.so
  TARGET_PDB = luisa-ast.so.dbg
  TARGET_SUPPORT_DIR = src/ast/CMakeFiles/luisa-compute-ast.dir


