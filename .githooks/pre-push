#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
while read -r local_ref local_sha remote_ref remote_sha; do
    # Deletions have no resulting tree to validate.
    case "$local_sha" in *[!0]*) ;; *) continue ;; esac
    # Validate each pushed tip, not HEAD or the worktree (multi-ref pushes).
    sh .githooks/run-pin-check --ref "$local_sha"
done
