/**
 * @file luisa-config.h
 * @brief LuisaCompute configuration header
 * 
 * This file is automatically generated during CMake configuration
 * and contains compile-time configuration options for LuisaCompute.
 */

#pragma once

/* Version information - use the existing version header */
#include "version.h"

/* Feature flags - Core features */
#cmakedefine01 LUISA_ENABLE_IR
#cmakedefine01 LUISA_ENABLE_DSL
#cmakedefine01 LUISA_ENABLE_GUI
#cmakedefine01 LUISA_ENABLE_API
#cmakedefine01 LUISA_ENABLE_XIR
#cmakedefine01 LUISA_ENABLE_CLANGCXX
#cmakedefine01 LUISA_ENABLE_TENSOR

/* Platform detection */
#cmakedefine01 LUISA_PLATFORM_WINDOWS
#cmakedefine01 LUISA_PLATFORM_UNIX
#cmakedefine01 LUISA_PLATFORM_APPLE

/* Platform-specific features */
#cmakedefine01 LUISA_ENABLE_WAYLAND

/* System library usage flags */
#cmakedefine01 LUISA_USE_SYSTEM_STL
#cmakedefine01 LUISA_USE_SYSTEM_SPDLOG
#cmakedefine01 LUISA_USE_SYSTEM_XXHASH
#cmakedefine01 LUISA_USE_SYSTEM_MAGIC_ENUM
#cmakedefine01 LUISA_USE_SYSTEM_GLFW
#cmakedefine01 LUISA_USE_SYSTEM_REPROC
#cmakedefine01 LUISA_USE_SYSTEM_YYJSON
#cmakedefine01 LUISA_USE_SYSTEM_MARL
#cmakedefine01 LUISA_USE_SYSTEM_LMDB
#cmakedefine01 LUISA_USE_SYSTEM_VULKAN

/* Windows-specific definitions */
#if LUISA_PLATFORM_WINDOWS
#  ifndef _DISABLE_CONSTEXPR_MUTEX_CONSTRUCTOR
#    define _DISABLE_CONSTEXPR_MUTEX_CONSTRUCTOR
#  endif
#endif

/* Compiler feature requirements */
#define LUISA_COMPUTE_C_STANDARD 11
#define LUISA_COMPUTE_CXX_STANDARD 20
