template<typename T>
T _ReadBdlsTex(T num){
return num&268435455;
}
template<typename T>
T _ReadBdlsSmp(T num){
return num>>28;
}
template<typename T>
T _ReadBdlsBuffer(StructuredBuffer<uint> s,T idx){
return s[idx*3];
}

#ifdef LUISA_DEBUG_INFO
// Debug: range-checked bindless buffer read macros with validate index
#define _READ_BUFFER(arr,arrIdx,idx,size,type,bf,vid) \
    (((arrIdx) < _Global[0]._validate_##vid) ? \
        bf[NonUniformResourceIndex(_ReadBdlsBuffer(arr,arrIdx))].template Load<type>(size*idx) : \
        (bf[NonUniformResourceIndex(_ReadBdlsBuffer(arr,0))].template Load<type>(0) * 0))
#define _READ_BUFFER_BYTES(arr,arrIdx,idx,type,bf,vid) \
    (((arrIdx) < _Global[0]._validate_##vid) ? \
        bf[NonUniformResourceIndex(_ReadBdlsBuffer(arr,arrIdx))].template Load<type>(idx) : \
        (bf[NonUniformResourceIndex(_ReadBdlsBuffer(arr,0))].template Load<type>(0) * 0))
#define _uniform_READ_BUFFER(arr,arrIdx,idx,size,type,bf,vid) \
    (((arrIdx) < _Global[0]._validate_##vid) ? \
        bf[(_ReadBdlsBuffer(arr,arrIdx))].template Load<type>(size*idx) : \
        (bf[(_ReadBdlsBuffer(arr,0))].template Load<type>(0) * 0))
#define _uniform_READ_BUFFER_BYTES(arr,arrIdx,idx,type,bf,vid) \
    (((arrIdx) < _Global[0]._validate_##vid) ? \
        bf[(_ReadBdlsBuffer(arr,arrIdx))].template Load<type>(idx) : \
        (bf[(_ReadBdlsBuffer(arr,0))].template Load<type>(0) * 0))
#define _typed_READ_BUFFER(arr,arrIdx,idx,size,type,bf,vid) \
    (((arrIdx) < _Global[0]._validate_##vid) ? \
        bf[NonUniformResourceIndex(arr[0]+arrIdx)].template Load<type>(size*idx) : \
        (bf[NonUniformResourceIndex(arr[0]+0)].template Load<type>(0) * 0))
#define _typed_READ_BUFFER_BYTES(arr,arrIdx,idx,type,bf,vid) \
    (((arrIdx) < _Global[0]._validate_##vid) ? \
        bf[NonUniformResourceIndex(arr[0]+arrIdx)].template Load<type>(idx) : \
        (bf[NonUniformResourceIndex(arr[0]+0)].template Load<type>(0) * 0))
#define _typed_uniform_READ_BUFFER(arr,arrIdx,idx,size,type,bf,vid) \
    (((arrIdx) < _Global[0]._validate_##vid) ? \
        bf[(arr[0]+arrIdx)].template Load<type>(size*idx) : \
        (bf[(arr[0]+0)].template Load<type>(0) * 0))
#define _typed_uniform_READ_BUFFER_BYTES(arr,arrIdx,idx,type,bf,vid) \
    (((arrIdx) < _Global[0]._validate_##vid) ? \
        bf[(arr[0]+arrIdx)].template Load<type>(idx) : \
        (bf[(arr[0]+0)].template Load<type>(0) * 0))
#else
#define _READ_BUFFER(arr,arrIdx,idx,size,type,bf) bf[NonUniformResourceIndex(_ReadBdlsBuffer(arr,arrIdx))].template Load<type>(size*idx)
#define _READ_BUFFER_BYTES(arr,arrIdx,idx,type,bf) bf[NonUniformResourceIndex(_ReadBdlsBuffer(arr,arrIdx))].template Load<type>(idx)
#define _uniform_READ_BUFFER(arr,arrIdx,idx,size,type,bf) bf[(_ReadBdlsBuffer(arr,arrIdx))].template Load<type>(size*idx)
#define _uniform_READ_BUFFER_BYTES(arr,arrIdx,idx,type,bf) bf[(_ReadBdlsBuffer(arr,arrIdx))].template Load<type>(idx)
#define _typed_READ_BUFFER(arr,arrIdx,idx,size,type,bf) bf[NonUniformResourceIndex(arr[0]+arrIdx)].template Load<type>(size*idx)
#define _typed_READ_BUFFER_BYTES(arr,arrIdx,idx,type,bf) bf[NonUniformResourceIndex(arr[0]+arrIdx)].template Load<type>(idx)
#define _typed_uniform_READ_BUFFER(arr,arrIdx,idx,size,type,bf) bf[(arr[0]+arrIdx)].template Load<type>(size*idx)
#define _typed_uniform_READ_BUFFER_BYTES(arr,arrIdx,idx,type,bf) bf[(arr[0]+arrIdx)].template Load<type>(idx)
#endif
template<typename T,typename I,typename J>
uint _bdlsBfSize(StructuredBuffer<uint> arr,I arrIdx,J size,T bf){
uint sz;
bf[NonUniformResourceIndex(_ReadBdlsBuffer(arr,arrIdx))].GetDimensions(sz);
return sz/size;
}
template<typename T,typename I,typename J>
uint _uniform_bdlsBfSize(StructuredBuffer<uint> arr,I arrIdx,J size,T bf){
uint sz;
bf[(_ReadBdlsBuffer(arr,arrIdx))].GetDimensions(sz);
return sz/size;
}
template<typename T,typename I,typename J>
uint _typed_bdlsBfSize(StructuredBuffer<uint> arr,I arrIdx,J size,T bf){
uint sz;
bf[NonUniformResourceIndex(arr[0]+arrIdx)].GetDimensions(sz);
return sz/size;
}
template<typename T,typename I,typename J>
uint _typed_uniform_bdlsBfSize(StructuredBuffer<uint> arr,I arrIdx,J size,T bf){
uint sz;
bf[(arr[0]+arrIdx)].GetDimensions(sz);
return sz/size;
}
