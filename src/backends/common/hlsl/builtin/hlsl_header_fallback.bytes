SamplerState _GETSMP(uint index){
switch(index){
case 0: return s_0;
case 1: return s_1;
case 2: return s_2;
case 3: return s_3;
case 4: return s_4;
case 5: return s_5;
case 6: return s_6;
case 7: return s_7;
case 8: return s_8;
