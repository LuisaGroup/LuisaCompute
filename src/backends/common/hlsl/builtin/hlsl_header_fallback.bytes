uint _lc_pack_set_u16(uint w,uint byte,uint16_t v){uint s=byte*8u;return (w&~(0xffffu<<s))|(((uint)v&0xffffu)<<s);}
int16_t _lc_pack_get_i16(uint w,uint byte){return (int16_t)(uint16_t)(w>>(byte*8u));}
uint _lc_pack_set_i16(uint w,uint byte,int16_t v){uint s=byte*8u;return (w&~(0xffffu<<s))|((uint)(uint16_t)v<<s);}
