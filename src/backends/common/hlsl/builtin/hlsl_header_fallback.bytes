template<typename T> T _lc_wrap_i8(T v){return (v<<(T)24)>>(T)24;}
uint _lc_byte_bfread_u8(ByteAddressBuffer b,uint idx){return (b.Load(idx&~3u)>>((idx&3u)*8u))&0xffu;}
uint _lc_byte_bfread_u8(RWByteAddressBuffer b,uint idx){return (b.Load(idx&~3u)>>((idx&3u)*8u))&0xffu;}
int _lc_byte_bfread_i8(ByteAddressBuffer b,uint idx){return ((int)(b.Load(idx&~3u)<<(24u-((idx&3u)*8u))))>>24;}
int _lc_byte_bfread_i8(RWByteAddressBuffer b,uint idx){return ((int)(b.Load(idx&~3u)<<(24u-((idx&3u)*8u))))>>24;}
uint _lc_volatile_byte_bfread_u8(RWByteAddressBuffer b,uint idx){DeviceMemoryBarrier();return _lc_byte_bfread_u8(b,idx);}
int _lc_volatile_byte_bfread_i8(RWByteAddressBuffer b,uint idx){DeviceMemoryBarrier();return _lc_byte_bfread_i8(b,idx);}
void _lc_byte_bfwrite_u8(RWByteAddressBuffer b,uint idx,uint v){uint addr=idx&~3u;uint s=(idx&3u)*8u;uint m=~(0xffu<<s);uint val=(v&0xffu)<<s;uint old=b.Load(addr);while(true){uint cur;b.InterlockedCompareExchange(addr,old,(old&m)|val,cur);if(cur==old)break;old=cur;}}
void _lc_volatile_byte_bfwrite_u8(RWByteAddressBuffer b,uint idx,uint v){_lc_byte_bfwrite_u8(b,idx,v);DeviceMemoryBarrier();}
