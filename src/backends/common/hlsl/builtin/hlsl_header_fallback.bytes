float3x4 _float3x3(float3 c0,float3 c1,float3 c2){float3x4 r=0;r[0][0]=c0.x;r[0][1]=c0.y;r[0][2]=c0.z;r[1][0]=c1.x;r[1][1]=c1.y;r[1][2]=c1.z;r[2][0]=c2.x;r[2][1]=c2.y;r[2][2]=c2.z;return r;}
float4x4 _float4x4(float4 c0,float4 c1,float4 c2,float4 c3){float4x4 r;r[0][0]=c0.x;r[0][1]=c0.y;r[0][2]=c0.z;r[0][3]=c0.w;r[1][0]=c1.x;r[1][1]=c1.y;r[1][2]=c1.z;r[1][3]=c1.w;r[2][0]=c2.x;r[2][1]=c2.y;r[2][2]=c2.z;r[2][3]=c2.w;r[3][0]=c3.x;r[3][1]=c3.y;r[3][2]=c3.z;r[3][3]=c3.w;return r;}
