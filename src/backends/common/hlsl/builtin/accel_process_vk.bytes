struct MeshInst{
float4 p0;
float4 p1;
float4 p2;
uint InstanceIDMask;
uint ContributionOffsetFlags;
uint2 accelStructPtr;
};
struct InputInst{
float4 p0;
float4 p1;
float4 p2;
uint2 mesh;
uint IndexVisibility;
uint UserIdFlags;
};
RWStructuredBuffer<MeshInst> _InstBuffer:register(u1);
StructuredBuffer<InputInst> _SetBuffer:register(t0);
struct _CBType{
uint dsp;
uint count;
};
[[vk::push_constant]] ConstantBuffer<_CBType> cb:register(b0);
[numthreads(256,1,1)]
void main(uint id:SV_DISPATCHTHREADID){
if(id >= cb.dsp) return;
const uint flag_mesh=1u << 0u;
const uint flag_transform=1u << 1u;
const uint flag_opaque_on = 1u << 2u;
const uint flag_opaque_off = 1u << 3u;
const uint flag_visibility = 1u << 4u;
const uint flag_user_id = 1u << 5u;
const uint flag_opaque = flag_opaque_on | flag_opaque_off;
InputInst v=_SetBuffer[id];
if((v.IndexVisibility & 0x00FFFFFFu)>=cb.count) return;
uint index = v.IndexVisibility & 0x00FFFFFFu;
uint vis_mask = (v.IndexVisibility >> 24u) & 0xFFu;
uint user_id = v.UserIdFlags & 0x00FFFFFFu;
uint flags = (v.UserIdFlags >> 24u) & 0xFFu;
if((flags&flag_transform)!=0){
_InstBuffer[index].p0=v.p0;
_InstBuffer[index].p1=v.p1;
_InstBuffer[index].p2=v.p2;
}
if((flags&flag_visibility)!=0){
uint id_mask = _InstBuffer[index].InstanceIDMask;
_InstBuffer[index].InstanceIDMask = (id_mask & 0x00FFFFFFu) | (vis_mask << 24u);
}
if((flags&flag_user_id)!=0){
uint id_mask = _InstBuffer[index].InstanceIDMask;
_InstBuffer[index].InstanceIDMask = (id_mask & 0xFF000000u) | user_id;
}
_InstBuffer[index].ContributionOffsetFlags = 0u;
if((flags&flag_opaque)!=0){
if((flags&flag_opaque_on)!=0)
_InstBuffer[index].ContributionOffsetFlags = 4u << 24u;
else
_InstBuffer[index].ContributionOffsetFlags |= 8u << 24u;
}
if((flags&flag_mesh)!=0){
_InstBuffer[index].accelStructPtr=v.mesh;
}
}
