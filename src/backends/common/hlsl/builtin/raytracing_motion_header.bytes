// Motion blur ray tracing header for VK_NV_ray_tracing_motion_blur
// Uses ray tracing pipeline with TraceRay for motion blur tracing only.
// Non-motion _TraceClosest/_TraceAny use inline RayQuery to avoid
// generating OpTraceRayKHR that could be incorrectly patched.
// A SPIR-V post-processing pass replaces OpTraceRayKHR with OpTraceRayMotionNV,
// extracting the time value from the payload's time field.

// Payload structure matching _Hit1 layout, with extra time field for SPIR-V patching.
struct _MotionPayload {
    uint inst_idx;   // v0: instance index (0xFFFFFFFF = miss)
    uint prim_idx;   // v1: primitive index
    float2 bary;     // v2: barycentrics
    float ray_t;     // v3: committed ray T
    float time;      // v4: motion blur time (for SPIR-V patcher)
};

// Miss shader entry point
[shader("miss")]
void main_miss(inout _MotionPayload payload) {
    payload.inst_idx = 4294967295u;
}

// Closest hit shader entry point
[shader("closesthit")]
void main_closesthit(inout _MotionPayload payload, BuiltInTriangleIntersectionAttributes attr) {
    payload.inst_idx = InstanceIndex();
    payload.prim_idx = PrimitiveIndex();
    payload.bary = attr.barycentrics;
    payload.ray_t = RayTCurrent();
}

// _TraceClosest uses inline RayQuery (no OpTraceRayKHR emitted).
// This avoids the SPIR-V patcher incorrectly converting it to OpTraceRayMotionNV
// which would cause a GPU hang when tracing against a non-motion TLAS.
template<typename T>
_Hit1 _TraceClosest(RaytracingAccelerationStructure accel, T rayDesc, uint mask) {
    RayDesc ray = _toRay(rayDesc);
    RayQuery<RAY_FLAG_FORCE_OPAQUE> q;
    q.TraceRayInline(accel, RAY_FLAG_FORCE_OPAQUE, mask, ray);
    q.Proceed();
    _Hit1 pl = (_Hit1)0;
    if (q.CommittedStatus() == COMMITTED_TRIANGLE_HIT) {
        pl.v0 = q.CommittedInstanceIndex();
        pl.v1 = q.CommittedPrimitiveIndex();
        pl.v2 = q.CommittedTriangleBarycentrics();
        pl.v3 = q.CommittedRayT();
    } else {
        pl.v0 = 4294967295;
    }
    return pl;
}

// _TraceAny uses inline RayQuery (no OpTraceRayKHR emitted).
template<typename T>
bool _TraceAny(RaytracingAccelerationStructure accel, T rayDesc, uint mask) {
    RayDesc ray = _toRay(rayDesc);
    RayQuery<RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH | RAY_FLAG_SKIP_CLOSEST_HIT_SHADER | RAY_FLAG_FORCE_OPAQUE> q;
    q.TraceRayInline(accel, RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH | RAY_FLAG_SKIP_CLOSEST_HIT_SHADER | RAY_FLAG_FORCE_OPAQUE, mask, ray);
    q.Proceed();
    return q.CommittedStatus() == COMMITTED_TRIANGLE_HIT;
}

template<typename T>
bool _TraceAnyMotion(RaytracingAccelerationStructure accel, T rayDesc, float time, uint mask) {
    RayDesc ray = _toRay(rayDesc);
    _MotionPayload payload;
    payload.inst_idx = 4294967295u;
    payload.prim_idx = 0u;
    payload.bary = float2(0, 0);
    payload.ray_t = 0.0f;
    payload.time = time;
    TraceRay(accel,
        RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH | RAY_FLAG_SKIP_CLOSEST_HIT_SHADER | RAY_FLAG_FORCE_OPAQUE,
        mask, 0, 0, 0, ray, payload);
    return payload.inst_idx != 4294967295u;
}

template<typename T>
_Hit1 _TraceClosestMotion(RaytracingAccelerationStructure accel, T rayDesc, float time, uint mask) {
    RayDesc ray = _toRay(rayDesc);
    _MotionPayload payload;
    payload.inst_idx = 4294967295u;
    payload.prim_idx = 0u;
    payload.bary = float2(0, 0);
    payload.ray_t = 0.0f;
    payload.time = time;
    TraceRay(accel,
        RAY_FLAG_FORCE_OPAQUE,
        mask, 0, 0, 0, ray, payload);
    _Hit1 result;
    result.v0 = payload.inst_idx;
    result.v1 = payload.prim_idx;
    result.v2 = payload.bary;
    result.v3 = payload.ray_t;
    return result;
}
