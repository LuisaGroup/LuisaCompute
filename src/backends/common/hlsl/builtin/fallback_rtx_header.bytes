// Fallback (software) ray tracing: the HLSL device-side traversal.
//
// This header is one of the three copies of the fallback acceleration-structure
// layout (see src/backends/common/rtx/fallback_rtx_layout.h, the single source of
// truth, and the CUDA copy cuda_builtin/cuda_device_fallback_rtx.h, which this
// file is a 1:1 port of).  It cannot include that header: every generated shader
// that traces with the fallback gets this text appended by the HLSL code
// generator (codegen_utils/entry_points.cpp), and it is compiled by dxc for both
// the DXIL target (the DX backend) and the SPIR-V target (the Vulkan backend's
// HLSL route), so it only uses constructs both targets accept:
//
//   * no recursion (the walks are iterative with an explicit stack),
//   * no resource-pointer arithmetic (see "the two views" below),
//   * no `RayQuery`, no `RaytracingAccelerationStructure` and no ray-tracing
//     pipeline intrinsics: a fallback trace is an ordinary compute kernel.
//
// ---------------------------------------------------------------------------
// The ABI, restated (see fallback_rtx_layout.h for the authoritative version)
// ---------------------------------------------------------------------------
//
// One *acceleration buffer* (`StructuredBuffer<uint4>`) holds every tree of the
// device and one *instance buffer* (`StructuredBuffer<uint4>` /
// `RWStructuredBuffer<uint4>`) holds the TLAS instance records.  A region starts
// with a 4 x uint4 header whose first lane is the region's own absolute uint4
// offset:
//
//   u4 0 : (base,            node_base,        node_count,  prim_count)
//   u4 1 : (blas_table_base, blas_count,       index_base,  index_count)
//   u4 2 : (vertex_base,     vertex_count,     root,        flags)
//   u4 3 : reserved
//
//   node    : 2 x u4, (lo.x, lo.y, lo.z, left), (hi.x, hi.y, hi.z, right)
//   blas    : 2 x u4, (blas_base, node_base, index_base, vertex_base),
//                     (triangle_count, flags, reserved, reserved)
//   index   : 1 x u4, (i0, i1, i2, 0)
//   vertex  : 1 x u4, (x, y, z, 0)
//   inst    : 8 x u4, three to_object rows, three to_world rows,
//                     (blas_index, visibility, user_id, flags), reserved
//
// Every float of the ABI travels as the *bit pattern* of its lane (the buffers
// are uint4), so the loaders below bit-cast; handles are never floats, which is
// what keeps `_LC_FB_INVALID_OFFSET` alive across the round trip.
//
// A node is a leaf when its left handle is `_LC_FB_INVALID_OFFSET`; `right` is
// then the triangle index inside the BLAS (or the instance index, in a TLAS).  A
// TLAS leaf names its BLAS through the instance record's `blas_index`, which
// indexes the BLAS table; the table record names the BLAS region, whose header is
// re-read exactly like the top-level region (a region is self-describing, which
// is why it starts with its own base).
//
// ---------------------------------------------------------------------------
// The two views, and why the acceleration view is *absolute*
// ---------------------------------------------------------------------------
//
// Both buffers reach the shader through the two registers the native `accel`
// argument already owns:
//
//   accel : the acceleration buffer, bound so that element 0 is the *first
//           uint4 of the buffer*, i.e. a handle is used as an ABSOLUTE index.
//   inst  : the instance buffer, bound at this tree's slice, so element 0 is the
//           tree's first instance record and `instance_u4 * instance` indexes it.
//
// `accelBase` is the absolute uint4 offset of this tree's region: the tree's
// header is `accel[accelBase + 0 .. 2]` and its root handle is the `root` field
// of that header.
//
// The acceleration view is deliberately absolute (and not a view that starts at
// the tree's region): a TLAS region may reference a BLAS region laid out *before*
// it, so a region-relative view would have to be indexed with a negative index,
// which neither a D3D12 root SRV nor a Vulkan descriptor range can express - the
// read would simply be out of range.  The CUDA port of this traversal uses raw
// pointers (`desc + (blas_base - base)`) and gets away with it; with a descriptor
// the only correct translation is to keep the buffer and address everything
// absolutely, which is what `accelBase` is for.
//
// The traversal therefore never needs a "region base" while it walks: a node
// handle, an index record, a vertex record and a BLAS region are all addressed by
// their absolute uint4 offset (which is exactly what the build packs into them).
//
// ---------------------------------------------------------------------------
// The walk
// ---------------------------------------------------------------------------
//
// The walk is the same two-level blind-push depth-first walk as
// examples/compute/lbvh/{blas,tlas}.cpp and as the CUDA copy: a node is loaded
// once, when popped, and is tested there, and the instance transform of a TLAS
// leaf is applied to the ray without renormalizing the direction, which keeps
// `t` the world-space ray parameter (this is what makes the software result match
// the hardware one).
//
// Limitations, reported rather than hidden:
//   * `opaque == false` instances are *hits* like opaque ones: the fallback has
//     no any-hit shading, so there is nothing to call.  The flag is recorded by
//     the build and honoured by the setters below, but it cannot change the
//     result of a trace.
//   * `flip_facing` / `disable_face_culling` do not change the intersection
//     test: triangles are two-sided here, exactly like the hardware geometry the
//     backends build.
//   * ray queries, motion blur, curves and procedural primitives are not
//     implemented; the HLSL code generator refuses to emit them in fallback mode
//     (with a message naming `use_fallback_rtx()`) instead of calling into a
//     missing symbol.

// ---------------------------------------------------------------------------
// Header slot indices, in uints (four per uint4) - restated from
// fallback_rtx_layout.h.
// ---------------------------------------------------------------------------
#define _LC_FB_HEADER_U4 4u
#define _LC_FB_NODE_U4 2u
#define _LC_FB_BLAS_RECORD_U4 2u
#define _LC_FB_INSTANCE_U4 8u
// Instance-record lane block of the to_object rows / the misc word.
#define _LC_FB_I_TO_OBJECT 0u
#define _LC_FB_I_TO_WORLD 3u
#define _LC_FB_I_MISC 6u
// Lanes of the misc word.
#define _LC_FB_IM_BLAS_INDEX 0u
#define _LC_FB_IM_VISIBILITY 1u
#define _LC_FB_IM_USER_ID 2u
#define _LC_FB_IM_FLAGS 3u
// Instance flags (mirror of `LC_INSTANCE_FLAG_*`); the build records them so the
// traversal can honour the same two behaviours the hardware does.
#define _LC_FB_INSTANCE_FLAG_DISABLE_FACE_CULLING 1u
#define _LC_FB_INSTANCE_FLAG_FLIP_FACING 2u
#define _LC_FB_INSTANCE_FLAG_DISABLE_ANY_HIT 4u
#define _LC_FB_INSTANCE_FLAG_ENFORCE_ANY_HIT 8u
#define _LC_FB_INSTANCE_FLAG_OPAQUE 16u
// The left handle of a leaf node, and the "no hit" marker of a traversal.
#define _LC_FB_INVALID_OFFSET 0xFFFFFFFFu
// Depth of the software traversal stack.  A Morton-code radix tree over the
// primitives of one tree is far shallower than this (the LBVH example uses the
// same bound).
#define _LC_FB_STACK_SIZE 64u

// ---------------------------------------------------------------------------
// Lane loaders: the ABI stores floats as the bit pattern of a uint lane.
// ---------------------------------------------------------------------------
float _LCFbAsFloat(uint u) { return asfloat(u); }
uint _LCFbAsUint(float f) { return asuint(f); }
float2 _LCFbFloat2Of(uint4 v) { return float2(asfloat(v.x), asfloat(v.y)); }
float3 _LCFbFloat3Of(uint4 v) { return float3(asfloat(v.x), asfloat(v.y), asfloat(v.z)); }
float4 _LCFbFloat4Of(uint4 v) { return float4(asfloat(v.x), asfloat(v.y), asfloat(v.z), asfloat(v.w)); }
uint4 _LCFbUint4Of(float4 v) { return uint4(asuint(v.x), asuint(v.y), asuint(v.z), asuint(v.w)); }

// ---------------------------------------------------------------------------
// A region's header fields.  `accel` is the whole acceleration buffer, so every
// field is loaded from the region's *absolute* offset `base`.
// ---------------------------------------------------------------------------
struct _LCFbRegion {
    uint base;
    uint node_base;
    uint blas_table_base;
    uint index_base;
    uint vertex_base;
    uint root;
    uint flags;
};

_LCFbRegion _LCFbRegionOf(StructuredBuffer<uint4> accel, uint base) {
    uint4 h0 = accel[base];
    uint4 h1 = accel[base + 1u];
    uint4 h2 = accel[base + 2u];
    _LCFbRegion region;
    region.base = h0.x;
    region.node_base = h0.y;
    region.blas_table_base = h1.x;
    region.index_base = h1.z;
    region.vertex_base = h2.x;
    region.root = h2.z;
    region.flags = h2.w;
    return region;
}

// ---------------------------------------------------------------------------
// Ray intersection helpers (the same maths as examples/compute/lbvh).
// ---------------------------------------------------------------------------

// Reciprocal of one lane that never produces an infinity from a zero direction
// (the same clamp the LBVH example uses).
float _LCFbReciprocalLane(float x) {
    return 1.0f / (abs(x) < 1.0e-20f ? 1.0e-20f : x);
}

// Reciprocal that never produces a NaN from a zero direction.
float3 _LCFbSafeReciprocal(float3 d) {
    return float3(_LCFbReciprocalLane(d.x),
                  _LCFbReciprocalLane(d.y),
                  _LCFbReciprocalLane(d.z));
}

// Slab test of an AABB, bounded by the current best hit.
bool _LCFbAabbTest(float3 lo, float3 hi, float3 origin, float3 inv_dir,
                   float t_min, float t_max) {
    float3 t0 = (lo - origin) * inv_dir;
    float3 t1 = (hi - origin) * inv_dir;
    float3 near_t = min(t0, t1);
    float3 far_t = max(t0, t1);
    float t_near = max(max(near_t.x, near_t.y), max(near_t.z, t_min));
    float t_far = min(min(far_t.x, far_t.y), min(far_t.z, t_max));
    return t_near <= t_far;
}

// Two-sided Moller-Trumbore.  Returns `true` and fills `t` / `bary` on a hit;
// `bary` follows the Luisa convention (`w0 = 1 - u - v`, `w1 = u`, `w2 = v`),
// which is what the hardware path's `CommittedTriangleBarycentrics()` reports
// too.  The transaction is not kept when it is not closer than `t_max`.
bool _LCFbTriangleTest(float3 v0, float3 v1, float3 v2,
                       float3 origin, float3 direction,
                       float t_min, float t_max,
                       out float t_out, out float2 bary_out) {
    float3 e1 = v1 - v0;
    float3 e2 = v2 - v0;
    float3 pv = cross(direction, e2);
    float det = dot(e1, pv);
    float inv_det = 1.0f / det;
    float3 tv = origin - v0;
    float u = dot(tv, pv) * inv_det;
    float3 qv = cross(tv, e1);
    float v = dot(direction, qv) * inv_det;
    float t = dot(e2, qv) * inv_det;
    bool hit = (abs(det) > 1.0e-12f) && (u >= 0.0f) && (v >= 0.0f) &&
               (u + v <= 1.0f) && (t >= t_min) && (t <= t_max);
    if (!hit) {
        t_out = t;
        bary_out = float2(0.0f, 0.0f);
        return false;
    }
    t_out = t;
    bary_out = float2(u, v);
    return true;
}

// ---------------------------------------------------------------------------
// The bottom-level walk: blind-push depth first over the nodes of one BLAS.
//
// `base` is the absolute uint4 offset of the BLAS region (element 0 of the region
// is its header), `instance` is the instance index the hit is reported with, and
// the ray is already in the object space of that instance.  `t_best` /
// `prim_best` / `bary_best` carry the best hit found so far (in world space) and
// are updated in place.
// ---------------------------------------------------------------------------
bool _LCFbWalkBlas(StructuredBuffer<uint4> accel, uint base, uint instance,
                   float3 origin, float3 direction, float t_min,
                   inout float t_best, inout uint prim_best, inout float2 bary_best) {
    // The walk reports whether it improved the best hit.  The caller (the TLAS
    // walk) uses that to decide whether the hit it just found is the one to
    // report, because two instances of the same mesh can be hit on the *same*
    // local triangle: comparing the primitive index instead (which is what the
    // CUDA copy of this traversal does) silently drops the nearer of the two and
    // reports the farther one.
    bool improved = false;
    _LCFbRegion region = _LCFbRegionOf(accel, base);
    float3 inv_dir = _LCFbSafeReciprocal(direction);
    uint stack[_LC_FB_STACK_SIZE];
    uint size = 1u;
    stack[0u] = region.root;
    while (size != 0u) {
        size = size - 1u;
        uint handle = stack[size];
        // One 32-byte node, read as its two uint4 planes.
        uint4 node_lo = accel[handle];
        uint4 node_hi = accel[handle + 1u];
        float3 lo = _LCFbFloat3Of(node_lo);
        float3 hi = _LCFbFloat3Of(node_hi);
        if (!_LCFbAabbTest(lo, hi, origin, inv_dir, t_min, t_best)) { continue; }
        uint left = node_lo.w;
        if (left == _LC_FB_INVALID_OFFSET) {
            // ---- triangle leaf: `right` is the local triangle index ----
            uint prim = node_hi.w;
            uint4 index = accel[region.index_base + prim];
            float3 v0 = _LCFbFloat3Of(accel[region.vertex_base + index.x]);
            float3 v1 = _LCFbFloat3Of(accel[region.vertex_base + index.y]);
            float3 v2 = _LCFbFloat3Of(accel[region.vertex_base + index.z]);
            float t;
            float2 bary;
            if (_LCFbTriangleTest(v0, v1, v2, origin, direction, t_min, t_best, t, bary)) {
                t_best = t;
                bary_best = bary;
                prim_best = prim;
                improved = true;
            }
        } else {
            // ---- internal node: push both children (blind push) ----
            if (size + 2u < _LC_FB_STACK_SIZE) {
                stack[size] = left;
                size = size + 1u;
                stack[size] = node_hi.w;
                size = size + 1u;
            }
        }
    }
    return improved;
}

// ---------------------------------------------------------------------------
// The top-level walk: the same blind-push walk over the instances of a TLAS.
// A leaf is an instance; it is descended into through the BLAS it references
// (`inst` is the instance buffer, element 0 = this tree's first instance record).
// ---------------------------------------------------------------------------
template<typename I>
void _LCFbWalkTlas(StructuredBuffer<uint4> accel, I inst, uint base, uint mask,
                   float3 origin, float3 direction, float t_min,
                   inout float t_best, inout uint inst_best,
                   inout uint prim_best, inout float2 bary_best) {
    _LCFbRegion region = _LCFbRegionOf(accel, base);
    float3 inv_dir = _LCFbSafeReciprocal(direction);
    float4 o4 = float4(origin.x, origin.y, origin.z, 1.0f);
    float4 d4 = float4(direction.x, direction.y, direction.z, 0.0f);
    uint stack[_LC_FB_STACK_SIZE];
    uint size = 1u;
    stack[0u] = region.root;
    while (size != 0u) {
        size = size - 1u;
        uint handle = stack[size];
        uint4 node_lo = accel[handle];
        uint4 node_hi = accel[handle + 1u];
        float3 lo = _LCFbFloat3Of(node_lo);
        float3 hi = _LCFbFloat3Of(node_hi);
        if (!_LCFbAabbTest(lo, hi, origin, inv_dir, t_min, t_best)) { continue; }
        uint left = node_lo.w;
        if (left == _LC_FB_INVALID_OFFSET) {
            // ---- instance leaf ----
            uint instance = node_hi.w;
            uint record_base = _LC_FB_INSTANCE_U4 * instance;
            uint4 misc = inst[record_base + _LC_FB_I_MISC];
            // Visibility: an instance is culled when its mask and the ray's share
            // no bit, exactly like the hardware's instance visibility.
            if ((mask & misc.y) == 0u) { continue; }
            // The BLAS table record of this instance names the BLAS region.  The
            // build keeps one record per instance, so the instance index and the
            // record's `blas_index` select the same row; the record's own lane is
            // used, as the CUDA port does.
            uint blas_index = misc.x;
            uint4 record0 = accel[region.blas_table_base + _LC_FB_BLAS_RECORD_U4 * blas_index];
            uint blas_base = record0.x;
            // `blas_base == 0` is the *null* reference: the first four uint4 of
            // the acceleration buffer are a reserved dummy region, so a record
            // whose base is 0 is an instance the caller never gave a mesh.
            // Descending into it would walk region 0; skip it instead
            // (fallback_rtx_layout.h).
            if (blas_base == 0u) { continue; }
            // World space -> object space: the three to_object rows as an
            // explicit row-major affine.  The direction is *not* renormalized, so
            // the triangle test keeps the world-space ray parameter.
            uint4 to_object_0 = inst[record_base + _LC_FB_I_TO_OBJECT + 0u];
            uint4 to_object_1 = inst[record_base + _LC_FB_I_TO_OBJECT + 1u];
            uint4 to_object_2 = inst[record_base + _LC_FB_I_TO_OBJECT + 2u];
            float4 o0 = _LCFbFloat4Of(to_object_0);
            float4 o1 = _LCFbFloat4Of(to_object_1);
            float4 o2 = _LCFbFloat4Of(to_object_2);
            float3 object_origin = float3(dot(o4, o0), dot(o4, o1), dot(o4, o2));
            float3 object_dir = float3(dot(d4, o0), dot(d4, o1), dot(d4, o2));
            float t_instance = t_best;
            uint prim_instance = prim_best;
            float2 bary_instance = bary_best;
            if (_LCFbWalkBlas(accel, blas_base, instance, object_origin, object_dir, t_min,
                              t_instance, prim_instance, bary_instance)) {
                t_best = t_instance;
                prim_best = prim_instance;
                bary_best = bary_instance;
                inst_best = instance;
            }
        } else {
            if (size + 2u < _LC_FB_STACK_SIZE) {
                stack[size] = left;
                size = size + 1u;
                stack[size] = node_hi.w;
                size = size + 1u;
            }
        }
    }
}

// ---------------------------------------------------------------------------
// The ABI entry points the code generator emits.  The two views and `accelBase`
// are described at the top of this file.
// ---------------------------------------------------------------------------

// Closest hit of `ray` against `mask`-visible instances.  On a miss the hit's
// instance index is `_LC_FB_INVALID_OFFSET` (the marker the DSL's
// `SurfaceHit::miss()` tests), its primitive index is `_LC_FB_INVALID_OFFSET`,
// its barycentrics are zero and its `t` is the ray's `t_max`.
template<typename R, typename I>
_Hit1 _FallbackTraceClosest(StructuredBuffer<uint4> accel, R rayDesc, uint mask,
                            I inst, uint accelBase) {
    _Hit1 hit = (_Hit1)0;
    hit.v0 = _LC_FB_INVALID_OFFSET;
    hit.v1 = _LC_FB_INVALID_OFFSET;
    hit.v2 = float2(0.0f, 0.0f);
    hit.v3 = rayDesc.v3;
    float3 origin = float3(rayDesc.v0.v[0], rayDesc.v0.v[1], rayDesc.v0.v[2]);
    float3 direction = float3(rayDesc.v2.v[0], rayDesc.v2.v[1], rayDesc.v2.v[2]);
    float t_best = rayDesc.v3;
    uint inst_best = _LC_FB_INVALID_OFFSET;
    uint prim_best = _LC_FB_INVALID_OFFSET;
    float2 bary_best = float2(0.0f, 0.0f);
    _LCFbWalkTlas(accel, inst, accelBase, mask, origin, direction, rayDesc.v1,
                  t_best, inst_best, prim_best, bary_best);
    if (inst_best != _LC_FB_INVALID_OFFSET) {
        hit.v0 = inst_best;
        hit.v1 = prim_best;
        hit.v2 = bary_best;
        hit.v3 = t_best;
    }
    return hit;
}

// Whether *any* triangle of a `mask`-visible instance is hit by `ray`.
template<typename R, typename I>
bool _FallbackTraceAny(StructuredBuffer<uint4> accel, R rayDesc, uint mask,
                       I inst, uint accelBase) {
    float3 origin = float3(rayDesc.v0.v[0], rayDesc.v0.v[1], rayDesc.v0.v[2]);
    float3 direction = float3(rayDesc.v2.v[0], rayDesc.v2.v[1], rayDesc.v2.v[2]);
    float t_best = rayDesc.v3;
    uint inst_best = _LC_FB_INVALID_OFFSET;
    uint prim_best = _LC_FB_INVALID_OFFSET;
    float2 bary_best = float2(0.0f, 0.0f);
    _LCFbWalkTlas(accel, inst, accelBase, mask, origin, direction, rayDesc.v1,
                  t_best, inst_best, prim_best, bary_best);
    return inst_best != _LC_FB_INVALID_OFFSET;
}

// ---------------------------------------------------------------------------
// Instance accessors (RAY_TRACING_INSTANCE_*) and their setters
// (RAY_TRACING_SET_INSTANCE_*).  They read and write the instance buffer, i.e.
// the records the build uploaded; the row convention of `_InstMatrix` is
// reproduced exactly, so a shader that reads back what it wrote sees the same
// matrix on both paths.
// ---------------------------------------------------------------------------

template<typename I>
float4x4 _FallbackInstMatrix(I inst, uint index) {
    uint record_base = _LC_FB_INSTANCE_U4 * index;
    // to_world rows, as the rows of the object->world matrix.
    float4 w0 = _LCFbFloat4Of(inst[record_base + _LC_FB_I_TO_WORLD + 0u]);
    float4 w1 = _LCFbFloat4Of(inst[record_base + _LC_FB_I_TO_WORLD + 1u]);
    float4 w2 = _LCFbFloat4Of(inst[record_base + _LC_FB_I_TO_WORLD + 2u]);
    // Identical to `_InstMatrix`, which unpacks the same three rows.
    return float4x4(
        float4(w0.x, w1.x, w2.x, 0.0f),
        float4(w0.y, w1.y, w2.y, 0.0f),
        float4(w0.z, w1.z, w2.z, 0.0f),
        float4(w0.w, w1.w, w2.w, 1.0f));
}

template<typename I>
uint _FallbackInstId(I inst, uint index) {
    return inst[_LC_FB_INSTANCE_U4 * index + _LC_FB_I_MISC][_LC_FB_IM_USER_ID];
}

template<typename I>
uint _FallbackInstVis(I inst, uint index) {
    return inst[_LC_FB_INSTANCE_U4 * index + _LC_FB_I_MISC][_LC_FB_IM_VISIBILITY];
}

void _FallbackSetAccelTransform(RWStructuredBuffer<uint4> inst, uint index, float4x4 m) {
    uint record_base = _LC_FB_INSTANCE_U4 * index;
    // to_world: the rows of the object->world matrix, the same twelve floats
    // `AccelBuildCommand::Modification::set_transform` packs.
    float4 w0 = float4(m[0][0], m[1][0], m[2][0], m[3][0]);
    float4 w1 = float4(m[0][1], m[1][1], m[2][1], m[3][1]);
    float4 w2 = float4(m[0][2], m[1][2], m[2][2], m[3][2]);
    inst[record_base + _LC_FB_I_TO_WORLD + 0u] = _LCFbUint4Of(w0);
    inst[record_base + _LC_FB_I_TO_WORLD + 1u] = _LCFbUint4Of(w1);
    inst[record_base + _LC_FB_I_TO_WORLD + 2u] = _LCFbUint4Of(w2);
    // to_object: the traversal transforms the ray with these rows, so they have
    // to follow the transform the caller just set.  The affine inverse of a
    // rotation/scale/translation is computed explicitly (3x3 inverse + the
    // negated transformed translation); a singular matrix leaves them as they
    // were, which culls nothing but also invents no geometry.
    float a00 = w0.x, a01 = w0.y, a02 = w0.z, t0 = w0.w;
    float a10 = w1.x, a11 = w1.y, a12 = w1.z, t1 = w1.w;
    float a20 = w2.x, a21 = w2.y, a22 = w2.z, t2 = w2.w;
    float c00 = a11 * a22 - a12 * a21;
    float c01 = a12 * a20 - a10 * a22;
    float c02 = a10 * a21 - a11 * a20;
    float det = a00 * c00 + a01 * c01 + a02 * c02;
    if (abs(det) > 1.0e-20f) {
        float inv_det = 1.0f / det;
        // rows of the inverse linear part
        float i00 = c00 * inv_det;
        float i01 = (a02 * a21 - a01 * a22) * inv_det;
        float i02 = (a01 * a12 - a02 * a11) * inv_det;
        float i10 = c01 * inv_det;
        float i11 = (a00 * a22 - a02 * a20) * inv_det;
        float i12 = (a02 * a10 - a00 * a12) * inv_det;
        float i20 = c02 * inv_det;
        float i21 = (a01 * a20 - a00 * a21) * inv_det;
        float i22 = (a00 * a11 - a01 * a10) * inv_det;
        float4 o0 = float4(i00, i01, i02, -(i00 * t0 + i01 * t1 + i02 * t2));
        float4 o1 = float4(i10, i11, i12, -(i10 * t0 + i11 * t1 + i12 * t2));
        float4 o2 = float4(i20, i21, i22, -(i20 * t0 + i21 * t1 + i22 * t2));
        inst[record_base + _LC_FB_I_TO_OBJECT + 0u] = _LCFbUint4Of(o0);
        inst[record_base + _LC_FB_I_TO_OBJECT + 1u] = _LCFbUint4Of(o1);
        inst[record_base + _LC_FB_I_TO_OBJECT + 2u] = _LCFbUint4Of(o2);
    }
}

void _FallbackSetAccelVis(RWStructuredBuffer<uint4> inst, uint index, uint mask) {
    uint slot = _LC_FB_INSTANCE_U4 * index + _LC_FB_I_MISC;
    uint4 misc = inst[slot];
    // The hardware masks the visibility to 8 bits (`_SetAccelVis`).
    misc[_LC_FB_IM_VISIBILITY] = mask & 0xffu;
    inst[slot] = misc;
}

void _FallbackSetAccelOpaque(RWStructuredBuffer<uint4> inst, uint index, bool opaque) {
    uint slot = _LC_FB_INSTANCE_U4 * index + _LC_FB_I_MISC;
    uint4 misc = inst[slot];
    uint flags = misc[_LC_FB_IM_FLAGS];
    // `_LC_FB_INSTANCE_FLAG_DISABLE_FACE_CULLING` marks a triangle mesh
    // (procedural primitives ignore the opaque flag), exactly like the hardware
    // setter.  The fallback has no any-hit shading, so this only records the
    // flag: a non-opaque instance is still a hit (documented limitation above).
    if ((flags & _LC_FB_INSTANCE_FLAG_DISABLE_FACE_CULLING) != 0u) {
        flags = flags & ~(_LC_FB_INSTANCE_FLAG_DISABLE_ANY_HIT |
                          _LC_FB_INSTANCE_FLAG_ENFORCE_ANY_HIT);
        flags = flags | (opaque ? _LC_FB_INSTANCE_FLAG_DISABLE_ANY_HIT
                                : _LC_FB_INSTANCE_FLAG_ENFORCE_ANY_HIT);
        misc[_LC_FB_IM_FLAGS] = flags;
        inst[slot] = misc;
    }
}

void _FallbackSetUserId(RWStructuredBuffer<uint4> inst, uint index, uint id) {
    uint slot = _LC_FB_INSTANCE_U4 * index + _LC_FB_I_MISC;
    uint4 misc = inst[slot];
    misc[_LC_FB_IM_USER_ID] = id;
    inst[slot] = misc;
}
