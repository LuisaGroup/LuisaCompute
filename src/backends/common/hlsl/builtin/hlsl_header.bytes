	#define _bfreadMat(bf,idx,bound) (((idx) < (bound)) ? bf[idx].m : (bf[0].m * 0) - 1)
	#define _bfwriteMat(bf,idx,value,bound) { if ((idx) < (bound)) { bf[idx].m = value; } }
	#define _bytebfreadMat(bf,type,idx,bound) (((idx) < (bound)) ? bf.template Load<type>(idx).m : (bf.template Load<type>(0).m * 0) - 1)
	#define _bytebfwriteMat(bf,type,idx,value,bound) { if ((idx) < (bound)) { type _tempm;_tempm.m=value;bf.template Store<type>(idx,_tempm); } }
#else
