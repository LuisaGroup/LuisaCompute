template<typename T>
T _round(T x){return sign(x)*floor(abs(x)+(T)0.5);}
template<typename T>
T _atan2(T y,T x){return (x==T(0)&&y==T(0))?T(0):atan2(y,x);}
template<typename T>
T _ctz(T x){return x==T(0)?T(32):firstbitlow(x);}
template<typename T>
T _fract(T x){return x-floor(x);}
