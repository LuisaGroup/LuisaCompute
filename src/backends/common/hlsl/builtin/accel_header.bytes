template<typename T>
float4x4 _InstMatrix(T instBuffer,uint index){
_MeshInst v=instBuffer[index];
return float4x4(
float4(v.p0.x,v.p1.x,v.p2.x,0),
float4(v.p0.y,v.p1.y,v.p2.y,0),
float4(v.p0.z,v.p1.z,v.p2.z,0),
float4(v.p0.w,v.p1.w,v.p2.w,1));
}
template<typename T>
uint _InstId(T instBuffer,uint index){
return instBuffer[index].InstanceID;
}
template<typename T>
uint _InstVis(T instBuffer,uint index){
return instBuffer[index].InstanceMask;
}
void _SetInstTransform(inout _MeshInst i,float4x4 mat){
i.p0=float4(mat[0].x,mat[1].x,mat[2].x,mat[3].x);
i.p1=float4(mat[0].y,mat[1].y,mat[2].y,mat[3].y);
i.p2=float4(mat[0].z,mat[1].z,mat[2].z,mat[3].z);
}
void _SetAccelTransform(RWStructuredBuffer<_MeshInst> buffer,uint index,float4x4 mat){
_SetInstTransform(buffer[index],mat);
}
void _SetAccelVis(RWStructuredBuffer<_MeshInst> buffer,uint index,uint mask){
buffer[index].InstanceMask=mask;
}
void _SetAccelOpaque(RWStructuredBuffer<_MeshInst> buffer,uint index,bool opaque){
buffer[index].Flags=select(opaque,4,8);
}
void _SetUserId(RWStructuredBuffer<_MeshInst> buffer,uint index,uint id){
buffer[index].InstanceID=id;
}
void _SetAccelMotionMatrix(RWStructuredBuffer<_MeshInst> buffer,RWByteAddressBuffer motionBuf,uint index,uint key,float4x4 mat){
_SetInstTransform(buffer[index],mat);
// Write to motion instance buffer (VkAccelerationStructureMatrixMotionInstanceNV layout)
// Stride=160, type(4)+flags(4)+transformT0(48)+transformT1(48)+metadata(16)=120
const uint kStride=160u;
uint base=index*kStride;
// Set type=MATRIX_MOTION(1), flags=0
motionBuf.Store(base,1u);
motionBuf.Store(base+4u,0u);
// Write VkTransformMatrixKHR (row-major float[3][4]) at offset 8+key*48
uint kfBase=base+8u+key*48u;
motionBuf.Store(kfBase+0u,asuint(mat[0].x));
motionBuf.Store(kfBase+4u,asuint(mat[1].x));
motionBuf.Store(kfBase+8u,asuint(mat[2].x));
motionBuf.Store(kfBase+12u,asuint(mat[3].x));
motionBuf.Store(kfBase+16u,asuint(mat[0].y));
motionBuf.Store(kfBase+20u,asuint(mat[1].y));
motionBuf.Store(kfBase+24u,asuint(mat[2].y));
motionBuf.Store(kfBase+28u,asuint(mat[3].y));
motionBuf.Store(kfBase+32u,asuint(mat[0].z));
motionBuf.Store(kfBase+36u,asuint(mat[1].z));
motionBuf.Store(kfBase+40u,asuint(mat[2].z));
motionBuf.Store(kfBase+44u,asuint(mat[3].z));
}
template<typename T>
float4x4 _GetAccelMotionMatrix(T motionBuf,uint index,uint key){
// Read from motion instance buffer
const uint kStride=160u;
uint base=index*kStride+8u+key*48u;
float r00=asfloat(motionBuf.Load(base+0u));
float r01=asfloat(motionBuf.Load(base+4u));
float r02=asfloat(motionBuf.Load(base+8u));
float r03=asfloat(motionBuf.Load(base+12u));
float r10=asfloat(motionBuf.Load(base+16u));
float r11=asfloat(motionBuf.Load(base+20u));
float r12=asfloat(motionBuf.Load(base+24u));
float r13=asfloat(motionBuf.Load(base+28u));
float r20=asfloat(motionBuf.Load(base+32u));
float r21=asfloat(motionBuf.Load(base+36u));
float r22=asfloat(motionBuf.Load(base+40u));
float r23=asfloat(motionBuf.Load(base+44u));
return float4x4(
float4(r00,r10,r20,0),
float4(r01,r11,r21,0),
float4(r02,r12,r22,0),
float4(r03,r13,r23,1));
}
template<typename SRT_T, typename T>
SRT_T _MakeSRTFromMatrix(T buffer,uint index){
SRT_T srt=(SRT_T)0;
_MeshInst inst=buffer[index];
srt.v0.v[0]=0;srt.v0.v[1]=0;srt.v0.v[2]=0;
srt.v1.v[0]=0;srt.v1.v[1]=0;srt.v1.v[2]=0;srt.v1.v[3]=1;
srt.v2.v[0]=1;srt.v2.v[1]=1;srt.v2.v[2]=1;
srt.v3.v[0]=0;srt.v3.v[1]=0;srt.v3.v[2]=0;
srt.v4.v[0]=inst.p0.w;srt.v4.v[1]=inst.p1.w;srt.v4.v[2]=inst.p2.w;
return srt;
}
// Read SRT keyframe from a vulkan motion instance buffer.
// Layout (VkAccelerationStructureMotionInstanceNV with 16-byte alignment to 160 bytes):
//   offset 0:  uint type (2 = SRT_MOTION_NV)
//   offset 4:  uint flags
//   offset 8:  VkSRTDataNV transformT0 (16 floats, 64 bytes) for keyframe 0
//   offset 72: VkSRTDataNV transformT1 (16 floats, 64 bytes) for keyframe 1
// VkSRTDataNV layout (16 floats):
//   [0]=sx,  [1]=a,   [2]=b,   [3]=pvx,
//   [4]=sy,  [5]=c,   [6]=pvy,
//   [7]=sz,  [8]=pvz,
//   [9]=qx,  [10]=qy, [11]=qz, [12]=qw,
//   [13]=tx, [14]=ty, [15]=tz
// MotionInstanceTransformSRT (the SRT_T returned to the user) field layout:
//   v0: pivot (3)
//   v1: quaternion (4)
//   v2: scale (3)
//   v3: shear (3)
//   v4: translation (3)
template<typename SRT_T>
SRT_T _MakeSRTFromMotionBuffer(ByteAddressBuffer motionBuf, uint inst_idx, uint key_idx){
SRT_T srt=(SRT_T)0;
const uint kStride=160u;
const uint kKeyframeOffset=8u;
const uint kKey1Stride=64u;
uint base=inst_idx*kStride+kKeyframeOffset+key_idx*kKey1Stride;
float sx =asfloat(motionBuf.Load(base+0u));
float a  =asfloat(motionBuf.Load(base+4u));
float b  =asfloat(motionBuf.Load(base+8u));
float pvx=asfloat(motionBuf.Load(base+12u));
float sy =asfloat(motionBuf.Load(base+16u));
float c  =asfloat(motionBuf.Load(base+20u));
float pvy=asfloat(motionBuf.Load(base+24u));
float sz =asfloat(motionBuf.Load(base+28u));
float pvz=asfloat(motionBuf.Load(base+32u));
float qx =asfloat(motionBuf.Load(base+36u));
float qy =asfloat(motionBuf.Load(base+40u));
float qz =asfloat(motionBuf.Load(base+44u));
float qw =asfloat(motionBuf.Load(base+48u));
float tx =asfloat(motionBuf.Load(base+52u));
float ty =asfloat(motionBuf.Load(base+56u));
float tz =asfloat(motionBuf.Load(base+60u));
srt.v0.v[0]=pvx;srt.v0.v[1]=pvy;srt.v0.v[2]=pvz;
srt.v1.v[0]=qx;srt.v1.v[1]=qy;srt.v1.v[2]=qz;srt.v1.v[3]=qw;
srt.v2.v[0]=sx;srt.v2.v[1]=sy;srt.v2.v[2]=sz;
srt.v3.v[0]=a;srt.v3.v[1]=b;srt.v3.v[2]=c;
srt.v4.v[0]=tx;srt.v4.v[1]=ty;srt.v4.v[2]=tz;
return srt;
}
