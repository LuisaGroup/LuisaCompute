+/*!
+ * \brief FP32 MPP multiply-accumulate with non-owning strided memory inputs.
+ *
+ * void cooperative_tensor_multiply_accumulate_from_memory(
+ *     Var d, PrimExpr index_d, PrimExpr ptr_a, PrimExpr stride_a,
+ *     PrimExpr ptr_b, PrimExpr stride_b, Var c, PrimExpr index_c,
+ *     int M, int N, int K, bool column_major_a, bool column_major_b);
+ *
+ * A is logically M x K, B is K x N, and C/D are M x N cooperative tensors
+ * in metal.cooperative_tensor storage. Strides are positive element strides;
+ * each input may reside in global or shared storage. Inputs are read at this
+ * call, not at an earlier view declaration. C is read and D is written; D may
+ * equal C. The caller must provide full, uniform participation of one complete
+ * 32-thread SIMD group, sufficient in-bounds storage, and memory synchronization.
+ * This Metal implementation requires static 8-multiple shapes and
+ * static fragment indices. It does not enable relaxed input precision.
+ */
+TVM_DLL const Op& cooperative_tensor_multiply_accumulate_from_memory();
