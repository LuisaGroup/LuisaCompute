+int64_t CooperativeConstant(const Expr& value, const char* label) {
+  const auto* imm = value.as<IntImmNode>();
+  TVM_FFI_ICHECK(imm) << "Metal cooperative tensor requires a constant " << label;
+  return imm->value;
+}
+
+bool CooperativeBoolean(const Expr& value) {
+  int64_t v = CooperativeConstant(value, "layout flag");
+  TVM_FFI_ICHECK(v == 0 || v == 1) << "Metal cooperative layout flag must be Boolean";
+  return v != 0;
+}
