+std::string CodeGenMetal::CooperativeTensorRef(const Expr& data, const Expr& index) {
+  Var var = GetSimdgroupBufferVar(data);
+  auto it = cooperative_tensors_.find(var.get());
+  TVM_FFI_ICHECK(it != cooperative_tensors_.end() && it->second.count != 0)
+      << "Missing Metal cooperative tensor allocation/contract for " << var;
+  int64_t i = CooperativeConstant(index, "fragment index");
+  TVM_FFI_ICHECK(i >= 0 && static_cast<uint64_t>(i) < it->second.count)
+      << "Metal cooperative tensor fragment index out of range";
+  return it->second.fragments.at(static_cast<size_t>(i));
+}
+
+std::string CodeGenMetal::CooperativeMemoryView(const Expr& pointer, const Expr& stride,
+                                                int64_t rows, int64_t columns, bool column_major) {
+  CheckCooperativeMemory(pointer, stride, rows, columns, column_major);
+  std::string scope = pointer->ty.as<PointerTypeNode>()->storage_scope;
+  int64_t ld = CooperativeConstant(stride, "leading stride");
+  // tensor_inline uses (column, row) coordinates. This helper also serves
+  // transfers; MMA inputs use physical row-major views plus descriptor flags.
+  std::ostringstream os;
+  std::string extents =
+      "extents<int, " + std::to_string(columns) + ", " + std::to_string(rows) + ">";
+  os << "tensor<" << (scope == "global" ? "device" : "threadgroup") << " float, " << extents
+     << ", tensor_inline>(" << PrintExpr(pointer) << ", " << extents << "{}, array<int, 2>{"
+     << (column_major ? ld : 1) << ", " << (column_major ? 1 : ld) << "})";
+  return os.str();
+}
