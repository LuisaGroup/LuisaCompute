+void CheckCooperativeMemory(const Expr& pointer, const Expr& stride, int64_t rows, int64_t columns,
+                            bool column_major) {
+  const auto* type = pointer->ty.as<PointerTypeNode>();
+  TVM_FFI_ICHECK(type && type->element_type == PrimType::Float(32))
+      << "Metal cooperative tensor memory inputs require typed FP32 pointers";
+  TVM_FFI_ICHECK(type->storage_scope == "global" || type->storage_scope == "shared")
+      << "Metal cooperative tensor memory must be global or shared, not " << type->storage_scope;
+  int64_t ld = CooperativeConstant(stride, "leading stride");
+  TVM_FFI_ICHECK(ld >= (column_major ? rows : columns) && ld <= std::numeric_limits<int>::max())
+      << "Invalid Metal cooperative tensor leading stride";
+}
