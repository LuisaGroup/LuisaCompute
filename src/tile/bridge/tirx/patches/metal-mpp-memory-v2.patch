+void CodeGenMetal::PrintCooperativeCall(const CallNode* op, std::ostream& os) {
+  bool fill = op->op.same_as(builtin::cooperative_tensor_fill());
+  bool load = op->op.same_as(builtin::cooperative_tensor_load());
+  bool store = op->op.same_as(builtin::cooperative_tensor_store());
+  bool multiply = op->op.same_as(builtin::cooperative_tensor_multiply_from_memory());
+  TVM_FFI_ICHECK_EQ(op->args.size(), fill ? 5 : (load || store || multiply ? 11 : 13));
+  std::string d = CooperativeTensorRef(op->args[0], op->args[1]);
+  const auto& info = cooperative_tensors_.at(GetSimdgroupBufferVar(op->args[0]).get());
+  if (fill) {
+    TVM_FFI_ICHECK_EQ(CooperativeConstant(op->args[3], "rows"), info.m);
+    TVM_FFI_ICHECK_EQ(CooperativeConstant(op->args[4], "columns"), info.n);
+    TVM_FFI_ICHECK(op->args[2]->ty == PrimType::Float(32));
+    std::string value = PrintExpr(op->args[2]);
+    std::string i = name_supply_->FreshName("mpp_element");
+    os << "{\n#pragma unroll\nfor (uint " << i << " = 0; " << i << " < " << d
+       << ".get_capacity(); ++" << i << ") { if (" << d << ".is_valid_element(" << i << ")) " << d
+       << '[' << i << "] = " << value << "; } }";
+  } else if (load || store) {
+    if (CooperativeBoolean(op->args[6])) {
+      // MPP's inline tensor transfer path does not preserve a nonunit inner
+      // stride on the validated SDK. Map the opaque destination distribution
+      // through its public coordinates, independently of memory orientation.
+      CheckCooperativeMemory(op->args[2], op->args[3], info.m, info.n, true);
+      std::string pointer = PrintExpr(op->args[2]);
+      std::string stride = PrintExpr(op->args[3]);
+      std::string p = name_supply_->FreshName("mpp_memory");
+      std::string i = name_supply_->FreshName("mpp_element");
+      std::string xy = name_supply_->FreshName("mpp_coordinate");
+      os << "{ auto " << p << " = " << pointer << ";\n#pragma unroll\nfor (uint " << i << " = 0; "
+         << i << " < " << d << ".get_capacity(); ++" << i << ") { if (" << d << ".is_valid_element("
+         << i << ")) { auto " << xy << " = " << d << ".get_multidimensional_index(" << i << "); ";
+      std::string element = p + "[" + xy + "[0] * " + stride + " + " + xy + "[1]]";
+      std::string fragment = d + "[" + i + "]";
+      os << (load ? fragment : element) << " = " << (load ? element : fragment) << "; } } }";
+    } else {
+      os << d << (load ? ".load(" : ".store(")
+         << CooperativeMemoryView(op->args[2], op->args[3], info.m, info.n, false) << ")";
+    }
+  } else {
+    std::string c;
+    if (!multiply) c = CooperativeTensorRef(op->args[6], op->args[7]);
+    // The MPP matmul ABI requires its transpose in the operation descriptor.
+    // Merely exchanging tensor strides does not implement a transposed MMA.
+    std::string av =
+        CooperativeMemoryView(op->args[2], op->args[3], info.transpose_a ? info.k : info.m,
+                              info.transpose_a ? info.m : info.k, false);
+    std::string bv =
+        CooperativeMemoryView(op->args[4], op->args[5], info.transpose_b ? info.n : info.k,
+                              info.transpose_b ? info.k : info.n, false);
+    std::string a = name_supply_->FreshName("mpp_left");
+    std::string b = name_supply_->FreshName("mpp_right");
+    os << "{ ";
+    if (!multiply && c != d) {
+      // Explicit element copy also avoids an SDK cooperative_tensor assignment
+      // constness defect. Both contracts and fragment bounds were checked above.
+      std::string i = name_supply_->FreshName("mpp_element");
+      os << "\n#pragma unroll\nfor (uint " << i << " = 0; " << i << " < " << d
+         << ".get_capacity(); ++" << i << ") { if (" << d << ".is_valid_element(" << i << ")) " << d
+         << '[' << i << "] = " << c << '[' << i << "]; } ";
+    }
+    os << "auto " << a << " = " << av << "; auto " << b << " = " << bv << "; "
+       << info.operation_type << "{}.run(" << a << ", " << b << ", " << d << "); }";
+  }
+}
