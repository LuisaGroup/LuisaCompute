+void CodeGenMetal::CollectCooperativeTensors(const PrimFunc& f) {
+  auto record = [&](const Expr& data, int64_t m, int64_t n, int64_t k) -> CooperativeTensorInfo& {
+    TVM_FFI_ICHECK(m > 0 && n > 0 && k > 0 && m % 8 == 0 && n % 8 == 0 && k % 8 == 0)
+        << "Metal MPP requires positive, static 8-multiple matrix shapes";
+    TVM_FFI_ICHECK(m % 16 == 0 || n % 16 == 0)
+        << "Metal MPP requires at least one of M or N to be a multiple of 16";
+    constexpr int64_t limit = std::numeric_limits<int>::max();
+    TVM_FFI_ICHECK(m <= limit / n && m <= limit / k && n <= limit / k)
+        << "Metal MPP matrix shape exceeds the int coordinate domain";
+    Var var = GetSimdgroupBufferVar(data);
+    auto [it, inserted] = cooperative_tensors_.emplace(var.get(), CooperativeTensorInfo{m, n, k});
+    TVM_FFI_ICHECK(inserted || (it->second.m == m && it->second.n == n && it->second.k == k))
+        << "Inconsistent Metal cooperative tensor matrix contracts for " << var;
+    return it->second;
+  };
+  tirx::PostOrderVisit(f->body, [&](const ffi::ObjectRef& node) {
+    const auto* call = node.as<CallNode>();
+    if (!call) return;
+    if (call->op.same_as(builtin::cooperative_tensor_multiply_from_memory())) {
+      TVM_FFI_ICHECK_EQ(call->args.size(), 11);
+      int64_t m = CooperativeConstant(call->args[6], "M");
+      int64_t n = CooperativeConstant(call->args[7], "N");
+      int64_t k = CooperativeConstant(call->args[8], "K");
+      bool ta = CooperativeBoolean(call->args[9]);
+      bool tb = CooperativeBoolean(call->args[10]);
+      auto& info = record(call->args[0], m, n, k);
+      TVM_FFI_ICHECK(!info.has_mma ||
+                     (info.multiply_only && info.transpose_a == ta && info.transpose_b == tb))
+          << "Inconsistent Metal cooperative tensor operation or operand layouts";
+      info.has_mma = true;
+      info.multiply_only = true;
+      info.transpose_a = ta;
+      info.transpose_b = tb;
+    } else if (call->op.same_as(builtin::cooperative_tensor_multiply_accumulate_from_memory())) {
+      TVM_FFI_ICHECK_EQ(call->args.size(), 13);
+      int64_t m = CooperativeConstant(call->args[8], "M");
+      int64_t n = CooperativeConstant(call->args[9], "N");
+      int64_t k = CooperativeConstant(call->args[10], "K");
+      bool ta = CooperativeBoolean(call->args[11]);
+      bool tb = CooperativeBoolean(call->args[12]);
+      for (int index : {0, 6}) {
+        auto& info = record(call->args[index], m, n, k);
+        TVM_FFI_ICHECK(!info.has_mma ||
+                       (!info.multiply_only && info.transpose_a == ta && info.transpose_b == tb))
+            << "Inconsistent Metal cooperative tensor operation or operand layouts";
+        info.has_mma = true;
+        info.multiply_only = false;
+        info.transpose_a = ta;
+        info.transpose_b = tb;
+      }
+    } else if (call->op.same_as(builtin::cooperative_tensor_load()) ||
+               call->op.same_as(builtin::cooperative_tensor_store())) {
+      TVM_FFI_ICHECK_EQ(call->args.size(), 11);
+      TVM_FFI_ICHECK_EQ(CooperativeConstant(call->args[10], "operand role"), 2)
+          << "This Metal MPP realization only materializes destination tensors";
+      int64_t m = CooperativeConstant(call->args[7], "M");
+      int64_t n = CooperativeConstant(call->args[8], "N");
+      int64_t k = CooperativeConstant(call->args[9], "K");
+      TVM_FFI_ICHECK_EQ(CooperativeConstant(call->args[4], "rows"), m);
+      TVM_FFI_ICHECK_EQ(CooperativeConstant(call->args[5], "columns"), n);
+      record(call->args[0], m, n, k);
+    }
+  });
+  if (!cooperative_tensors_.empty()) {
