diff --git a/test/tests/ret_eltype.ll b/test/tests/ret_eltype.ll
new file mode 100644
index 0000000000000000000000000000000000000000..45a6d49d3e6b5dfe0db75d212e8900c0a853892c
--- /dev/null
+++ b/test/tests/ret_eltype.ll
@@ -0,0 +1,23 @@
+; MIN-LLVM: 15  (uses opaque `ptr`; opaque pointers are LLVM 15+)
+; VERSIONS: 14.0
+; Pointer-returning functions use ret_eltype to recover the typed pointer in
+; LLVM 14 bitcode. The call result must carry that same type so its inserted
+; no-op cast and downstream typed call remain well-formed.
+%resource = type { i8 }
+
+declare !ret_eltype !0 ptr addrspace(2) @get_resource()
+declare !arg_eltypes !1 void @consume_resource(ptr addrspace(2))
+
+define void @test() {
+  %resource = call ptr addrspace(2) @get_resource()
+  call void @consume_resource(ptr addrspace(2) %resource)
+  ret void
+}
+
+!0 = !{%resource undef}
+!1 = !{i32 0, %resource undef}
+
+; CHECK: declare{{.*}}%resource addrspace(2)* @get_resource()
+; CHECK: declare{{.*}}void @consume_resource(%resource addrspace(2)*)
+; CHECK: call %resource addrspace(2)* @get_resource()
+; CHECK: call void @consume_resource(%resource addrspace(2)*
diff --git a/test/tests/struct_eltypes.ll b/test/tests/struct_eltypes.ll
new file mode 100644
index 0000000000000000000000000000000000000000..d6db9495315496828de11e61e7d55198884c7f87
--- /dev/null
+++ b/test/tests/struct_eltypes.ll
@@ -0,0 +1,22 @@
+; MIN-LLVM: 15  (uses opaque `ptr`; opaque pointers are LLVM 15+)
+; VERSIONS: 14.0
+; llvm.struct_eltypes restores typed pointers embedded in named structs. This
+; nested wrapper shape also checks that replacement pointee types are enumerated
+; before the containing structs are emitted to the LLVM 14 type table.
+%texture = type { i8 }
+%resource_wrapper = type { ptr addrspace(1) }
+%argument_buffer = type { i32, ptr addrspace(2) }
+
+define void @consume_argument_buffer(ptr addrspace(2) %buffer) !arg_eltypes !2 {
+  ret void
+}
+
+!llvm.struct_eltypes = !{!0, !1}
+!0 = !{!"resource_wrapper", i32 0, %texture undef}
+!1 = !{!"argument_buffer", i32 1, %resource_wrapper undef}
+!2 = !{i32 0, %argument_buffer undef}
+
+; CHECK-DAG: %resource_wrapper = type { %texture addrspace(1)* }
+; CHECK-DAG: %argument_buffer = type { i32, %resource_wrapper addrspace(2)* }
+; CHECK: define void @consume_argument_buffer(%argument_buffer addrspace(2)*
+; CHECK-NOT: !llvm.struct_eltypes
