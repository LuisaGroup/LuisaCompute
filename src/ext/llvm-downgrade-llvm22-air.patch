+// Build typed-pointer overrides for pointer fields embedded in structs. Opaque
+// LLVM IR cannot carry these types directly, but some legacy consumers (AIR in
+// particular) use the pointee types of argument-buffer fields as part of their
+// resource ABI. Front-ends describe those fields with named metadata entries:
+//
+//   !llvm.struct_eltypes = !{!0}
+//   !0 = !{!"struct.name", i32 1, %element.type undef, ...}
+StructPointerTypeMap
+PointerRewriter::buildStructPointerTypeMap(const Module &M) {
+  StructPointerTypeMap StructPointerMap;
+  auto *Named = M.getNamedMetadata("llvm.struct_eltypes");
+  if (!Named)
+    return StructPointerMap;
+
+  for (const MDNode *MD : Named->operands()) {
+    assert(MD->getNumOperands() >= 3 && (MD->getNumOperands() % 2) == 1 &&
+           "Invalid llvm.struct_eltypes metadata");
+    auto Name = cast<MDString>(MD->getOperand(0))->getString();
+    auto *Struct = StructType::getTypeByName(M.getContext(), Name);
+    assert(Struct && !Struct->isOpaque() &&
+           "Unknown struct in llvm.struct_eltypes metadata");
+    auto &Fields = StructPointerMap[Struct];
+    Fields.resize(Struct->getNumElements());
+    for (unsigned I = 1; I < MD->getNumOperands(); I += 2) {
+      auto *IndexValue =
+          cast<ConstantAsMetadata>(MD->getOperand(I))->getValue();
+      auto Index = cast<ConstantInt>(IndexValue)->getZExtValue();
+      assert(Index < Struct->getNumElements() &&
+             "Invalid struct field in llvm.struct_eltypes metadata");
+      auto *OpaquePointer =
+          cast<PointerType>(Struct->getElementType(Index));
+      auto *Element =
+          cast<ValueAsMetadata>(MD->getOperand(I + 1))->getValue()->getType();
+      Fields[Index] = TypedPointerType::get(
+          Element, OpaquePointer->getAddressSpace());
+    }
+  }
+  return StructPointerMap;
+}
+
 bool PointerRewriter::run() {
   bool Changed = demotePointerConstants(M);
 
