+; MIN-LLVM: 15  (uses opaque `ptr`; opaque pointers are LLVM 15+)
+; VERSIONS: 14.0
+; llvm.struct_eltypes restores typed pointers embedded in named structs. This
+; nested wrapper shape also checks that replacement pointee types are enumerated
+; before the containing structs are emitted to the LLVM 14 type table.
+%texture = type { i8 }
+%resource_wrapper = type { ptr addrspace(1) }
+%argument_buffer = type { i32, ptr addrspace(2) }
+
+define void @consume_argument_buffer(ptr addrspace(2) %buffer) !arg_eltypes !2 {
+  ret void
+}
+
+!llvm.struct_eltypes = !{!0, !1}
+!0 = !{!"resource_wrapper", i32 0, %texture undef}
+!1 = !{!"argument_buffer", i32 1, %resource_wrapper undef}
+!2 = !{i32 0, %argument_buffer undef}
+
