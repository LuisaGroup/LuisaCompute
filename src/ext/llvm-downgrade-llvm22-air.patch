@@ -0,0 +1,35 @@
+#pragma once
+
+#include "llvm/Config/llvm-config.h"
+
+#if LLVM_VERSION_MAJOR >= 23
+#include "llvm/ADT/FloatingPointMode.h"
+#include "llvm/ADT/SmallVector.h"
+#include "llvm/ADT/StringRef.h"
+#include <cstdint>
+
+namespace llvmdg {
+
+// LLVM 23 replaced the two string attributes with denormal_fpenv. Preserve
+// both complete output/input modes when targeting readers from before LLVM 23.
+// A null Record is the attribute-group enumerator's counting-only operation.
+inline unsigned
+encodeLegacyDenormalFPEnv(llvm::DenormalFPEnv Env,
+                         llvm::SmallVectorImpl<uint64_t> *Record) {
+  if (Record) {
+    auto Emit = [&](llvm::StringRef Name, llvm::DenormalMode Mode) {
+      auto Value = Mode.str(); // legacy names and output,input order
+      Record->push_back(4); // string attribute with a value
+      Record->append(Name.begin(), Name.end());
+      Record->push_back(0);
+      Record->append(Value.begin(), Value.end());
+      Record->push_back(0);
+    };
+    Emit("denormal-fp-math", Env.DefaultMode);
+    Emit("denormal-fp-math-f32", Env.F32Mode);
+  }
+  return 2;
+}
+
+} // namespace llvmdg
+#endif
--- /dev/null
+++ b/common/LegacyConstants.h
@@ -0,0 +1,30 @@
+#pragma once
+
+#include "DowngradeError.h"
+#include "llvm/Config/llvm-config.h"
+#include "llvm/IR/Constants.h"
+#include "llvm/IR/DerivedTypes.h"
+
+namespace llvmdg {
+
+// LLVM 23 represents numeric vector splats as zero-operand ConstantInt/FP.
+// Older readers require an aggregate referencing separately encoded scalar
+// constants. Preserve APInt/APFloat bits, including wide values and NaNs.
+inline llvm::Constant *getLegacyVectorSplatElement(const llvm::Constant *C) {
+#if LLVM_VERSION_MAJOR >= 23
+  if (!C->getType()->isVectorTy() || C->isNullValue() ||
+      !llvm::isa<llvm::ConstantInt, llvm::ConstantFP>(C))
+    return nullptr;
+  if (!llvm::isa<llvm::FixedVectorType>(C->getType()))
+    reportError("scalable numeric vector splats are not supported by the IR downgrader");
+  if (auto *CI = llvm::dyn_cast<llvm::ConstantInt>(C))
+    return llvm::ConstantInt::get(C->getContext(), CI->getValue());
+  return llvm::ConstantFP::get(C->getContext(),
+                               llvm::cast<llvm::ConstantFP>(C)->getValueAPF());
+#else
+  (void)C;
+  return nullptr;
+#endif
+}
+
+} // namespace llvmdg
