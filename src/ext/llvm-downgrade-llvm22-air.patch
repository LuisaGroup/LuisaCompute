-// Throw directly from the writers: LLVM may be built without unwind cleanups.
+// Embedded callers can retain the original fatal-error contract without
+// allowing a writer exception to cross a noexcept or exception-free boundary.
+// The upstream C API keeps its recoverable exception contract by default.
 [[noreturn]] inline void reportError(const llvm::Twine &Message) {
+#if defined(LLVMDG_ABORT_ON_ERROR)
+  llvm::report_fatal_error(Message, false);
+#else
   throw DowngradeError{Message.str()};
+#endif
 }
 
